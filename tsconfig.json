{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"types": ["@cloudflare/workers-types", "vitest/globals"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "**/*.test.ts", "**/*.test-d.ts", "vitest.config*.ts"]
}
