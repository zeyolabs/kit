{
	"name": "@zeyolabs/kit",
	"version": "2026.11.5",
	"description": "Shared SvelteKit-on-Cloudflare server toolkit: remote-function wrappers, passwordless auth (magic link + passkeys), email over a send_email binding or SMTP, Cloudflare context, monitoring, storage clients, utils and the ESLint config.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zeyolabs/kit.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": "^11.0.0"
	},
	"files": [
		"eslint-config.js",
		"auth",
		"cloudflare",
		"monitoring",
		"server",
		"storage",
		"utils",
		"!**/*.test.ts",
		"!**/*.test-d.ts",
		"!**/*.integration.test.ts",
		"!**/__fixtures__",
		"!**/*.proto",
		"!**/buf*.yaml"
	],
	"scripts": {
		"generate:proto": "cd monitoring/prometheus && buf generate",
		"lint": "eslint . --cache --cache-location .cache/.eslintcache --cache-strategy content",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.config.integration.ts",
		"check": "prettier --check . && pnpm lint && pnpm typecheck && pnpm test",
		"fmt": "prettier --write .",
		"release": "node scripts/release.mjs"
	},
	"exports": {
		"./eslint-config": "./eslint-config.js",
		"./utils/*": "./utils/*.ts",
		"./auth/*": "./auth/*.ts",
		"./server/*": "./server/*.ts",
		"./cloudflare/*": "./cloudflare/*.ts",
		"./cloudflare/context": "./cloudflare/context.ts",
		"./cloudflare/amqp": "./cloudflare/amqp/client.ts",
		"./cloudflare/dispatch": "./cloudflare/dispatch/client.ts",
		"./cloudflare/email": "./cloudflare/email/client.ts",
		"./cloudflare/email/dev": "./cloudflare/email/dev.ts",
		"./cloudflare/email/testing": "./cloudflare/email/testing.ts",
		"./cloudflare/r2": "./cloudflare/r2/client.ts",
		"./cloudflare/r2/testing": "./cloudflare/r2/testing.ts",
		"./cloudflare/smtp": "./cloudflare/smtp/client.ts",
		"./cloudflare/wait-until": "./cloudflare/wait-until.ts",
		"./cloudflare/workers": "./cloudflare/workers/index.ts",
		"./cloudflare/workers-ai": "./cloudflare/workers-ai/client.ts",
		"./cloudflare/workers-ai/testing": "./cloudflare/workers-ai/testing.ts",
		"./cloudflare/workers/testing": "./cloudflare/workers/testing.ts",
		"./cloudflare/workers/ticking-do": "./cloudflare/workers/ticking-do.ts",
		"./monitoring/alerts": "./monitoring/alerts/client.ts",
		"./monitoring/alerts/event-config": "./monitoring/alerts/event-config.ts",
		"./monitoring/alerts/policy": "./monitoring/alerts/policy.ts",
		"./monitoring/alerts/registry": "./monitoring/alerts/registry.ts",
		"./monitoring/gates": "./monitoring/gates/client.ts",
		"./monitoring/gates/dev": "./monitoring/gates/dev.ts",
		"./monitoring/gates/testing": "./monitoring/gates/testing.ts",
		"./monitoring/logger": "./monitoring/logger/client.ts",
		"./monitoring/prometheus": "./monitoring/prometheus/client.ts",
		"./monitoring/prometheus/dev": "./monitoring/prometheus/dev.ts",
		"./monitoring/prometheus/metrics": "./monitoring/prometheus/metrics.ts",
		"./monitoring/prometheus/testing": "./monitoring/prometheus/testing.ts",
		"./monitoring/slack": "./monitoring/slack/client.ts",
		"./monitoring/slack/api": "./monitoring/slack/api.ts",
		"./monitoring/slack/events": "./monitoring/slack/events.ts",
		"./storage/clickhouse": "./storage/clickhouse/index.ts",
		"./storage/clickhouse/dev": "./storage/clickhouse/dev.ts",
		"./storage/clickhouse/testing": "./storage/clickhouse/testing.ts",
		"./storage/manticore": "./storage/manticore/client.ts",
		"./storage/postgres": "./storage/postgres/client.ts",
		"./storage/postgres/testing": "./storage/postgres/testing.ts",
		"./storage/redis": "./storage/redis/client.ts",
		"./storage/redis/testing": "./storage/redis/testing.ts"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.16.0",
		"@clickhouse/client-web": "1.24.0",
		"@clickhouse/rowbinary": "0.1.1",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "9.39.4",
		"@internationalized/date": "3.12.4",
		"@oslojs/crypto": "1.0.1",
		"@oslojs/encoding": "1.1.0",
		"@oslojs/webauthn": "1.0.0",
		"@sentry/cloudflare": "11.4.0",
		"aws4fetch": "1.0.20",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-drizzle": "0.2.3",
		"eslint-plugin-perfectionist": "5.9.1",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.13.0",
		"mimetext": "3.0.28",
		"mysql2": "3.24.5",
		"pg": "8.23.1",
		"snappyjs": "0.7.0",
		"svelte-eslint-parser": "1.8.1",
		"tldts": "7.4.16",
		"typescript-eslint": "8.71.0",
		"worker-mailer": "1.3.1"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": "*",
		"@electric-sql/pglite": "^0.5.8",
		"@sentry/sveltekit": "^11.4.0",
		"@sveltejs/kit": "^3.1.1",
		"drizzle-orm": "^0.45.3",
		"eslint": "^9.39.4",
		"vitest": "^4.1.11",
		"zod": "^4.6.5"
	},
	"peerDependenciesMeta": {
		"@cloudflare/workers-types": {
			"optional": true
		},
		"@electric-sql/pglite": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@bufbuild/buf": "1.73.0",
		"@bufbuild/protoc-gen-es": "2.16.0",
		"@cloudflare/workers-types": "5.20261005.1",
		"@electric-sql/pglite": "0.5.8",
		"@libsql/client": "0.18.0",
		"@sentry/sveltekit": "11.4.0",
		"@sveltejs/kit": "3.1.1",
		"@types/pg": "8.23.1",
		"@types/snappyjs": "0.7.1",
		"drizzle-orm": "0.45.3",
		"eslint": "9.39.4",
		"prettier": "3.9.9",
		"svelte": "5.57.3",
		"typescript": "6.0.3",
		"vitest": "4.1.11",
		"zod": "4.6.5"
	}
}
